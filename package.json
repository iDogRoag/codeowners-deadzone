{
  "name": "codeowners-deadzone",
  "version": "0.1.0",
  "description": "Find weak, missing, or misleading CODEOWNERS coverage in a repository.",
  "type": "module",
  "license": "MIT",
  "author": "iDogRoag",
  "packageManager": "npm@10.9.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iDogRoag/codeowners-deadzone.git"
  },
  "bugs": {
    "url": "https://github.com/iDogRoag/codeowners-deadzone/issues"
  },
  "homepage": "https://github.com/iDogRoag/codeowners-deadzone#readme",
  "keywords": [
    "codeowners",
    "github",
    "github-actions",
    "ownership",
    "code-review",
    "security",
    "devtools",
    "oss",
    "repository",
    "static-analysis"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codeowners-deadzone": "./dist/cli.js",
    "codz": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "minimatch": "^10.0.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.19",
    "eslint": "^9.39.4",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.0.14"
  }
}
